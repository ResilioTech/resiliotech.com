{
  "name": "resiliotech-jamstack",
  "version": "2.0.0",
  "description": "Resiliotech website built with Jamstack architecture for optimal performance",
  "main": "index.js",
  "scripts": {
    "dev": "eleventy --serve --watch",
    "build": "cross-env NODE_ENV=production eleventy",
    "build:netlify": "NODE_ENV=production eleventy",
    "build:prod": "npm run build && npm run optimize && npm run fingerprint",
    "build:prod:netlify": "npm run build:netlify && npm run optimize && npm run fingerprint",
    "optimize": "node scripts/optimize-assets.js",
    "fingerprint": "node scripts/fingerprint-assets.js",
    "preview": "eleventy --serve",
    "clean": "rimraf dist",
    "lint": "eslint src/**/*.js",
    "test": "jest",
    "analyze": "webpack-bundle-analyzer dist/assets/js/*.js"
  },
  "keywords": [
    "jamstack",
    "eleventy",
    "static-site",
    "performance",
    "devops",
    "startup"
  ],
  "author": "Resiliotech",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "eleventy-plugin-rev": "^1.0.0",
    "eslint": "^8.52.0",
    "imagemin": "^8.0.1",
    "imagemin-avif": "^0.1.5",
    "imagemin-webp": "^7.0.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "webpack-bundle-analyzer": "^4.9.1"
  },
  "dependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-plugin-bundle": "^1.0.4",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "cssnano": "^6.0.1",
    "dotenv": "^16.3.1",
    "html-minifier": "^4.0.0",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "terser": "^5.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
